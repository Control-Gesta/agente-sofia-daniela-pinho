# === Kommo ===
KOMMO_DOMAIN=https://SUACONTA.kommo.com
KOMMO_TOKEN=   # token de longa duração (Configurações → Integrações)
KOMMO_ACCOUNT_ID=   # id da conta (aparece no payload do webhook: account[id])
# Salesbot de ENVIO (obrigatório com TRANSPORT=salesbot) — ver README
KOMMO_BOT_ID=

# === Transport ===
# salesbot = Desenho A (WhatsApp oficial no Kommo, sem voz) — o único usado
# neste projeto (a Sofia nunca envia áudio)
TRANSPORT=salesbot
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_AUTO_CREATE_LEAD=0
UAZAPI_RELAY_URL=

# === Cérebro (OpenAI — decisão do cliente, não é o Claude validado pelo curso) ===
OPENAI_API_KEY=   # platform.openai.com → API keys
OPENAI_MODEL=gpt-5.4-mini

# === Webhook ===
# Secret exigido em /api/inbound, /api/salesbot, /api/validate
WEBHOOK_SECRET=troque-por-um-secret-forte

# === Comportamento ===
DEBOUNCE_SECONDS=10
# Tag no LEAD que desliga o agente (humano assumiu)
HUMAN_TAG=atendimento-humano
# Tag no LEAD que LIGA o agente (rampagem gradual). Vazio = responde todos.
GATE_TAG=sofia-ativa

# === Upstash Redis (OBRIGATÓRIO — histórico da conversa mora aqui) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Voz e follow-up automático: DESLIGADOS neste projeto ===
# A Sofia nunca envia áudio (Desenho A não suporta + guia da clínica proíbe) e
# o follow-up automático está dormente por decisão da cliente (ver
# lib/crm-map.ts). ELEVENLABS_* e CRON_SECRET não são usados aqui.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === Só pros scripts de teste locais (scripts/simulate_inbound.py) ===
DEPLOY_URL=   # a URL do seu deploy, ex: https://<seu-deploy>
